diff --git a/.github/workflows/social.yml b/.github/workflows/social.yml
new file mode 100644
index 0000000..63c18e8
--- /dev/null
+++ b/.github/workflows/social.yml
@@ -0,0 +1,65 @@
+name: Podsumowanie dnia w mediach społecznościowych
+
+# Posts the summary of a voting day (python -m sejmomat.social post) on the
+# services whose credentials are set as repository secrets:
+#   X:       X_API_KEY, X_API_SECRET, X_ACCESS_TOKEN, X_ACCESS_TOKEN_SECRET
+#   Bluesky: BLUESKY_HANDLE, BLUESKY_APP_PASSWORD
+# Scheduled runs do nothing unless the repository variable SOCIAL_AUTOPOST is
+# "true". A manual run only shows what would be posted, unless told to publish.
+on:
+  schedule:
+    - cron: "30 7 * * *"   # the morning after a voting day: 9:30 in summer, 8:30 in winter
+  workflow_dispatch:
+    inputs:
+      publish:
+        description: "Opublikuj naprawdę (bez tego tylko pokaże treść wpisów)"
+        type: boolean
+        default: false
+
+permissions:
+  contents: write
+
+concurrency:
+  group: social
+  cancel-in-progress: false
+
+jobs:
+  post:
+    if: github.event_name == 'workflow_dispatch' || vars.SOCIAL_AUTOPOST == 'true'
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      # the script reads the published api/v1/summaries.json, so it needs
+      # only its own code and the record of what was already posted
+      - uses: actions/checkout@v4
+        with:
+          sparse-checkout-cone-mode: false
+          sparse-checkout: |
+            /sejmomat/
+            /data/social.json
+
+      - name: Post what is due
+        env:
+          SITE_URL: ${{ vars.SITE_URL }}
+          SOCIAL_DRY_RUN: ${{ github.event_name == 'workflow_dispatch' && !inputs.publish }}
+          X_API_KEY: ${{ secrets.X_API_KEY }}
+          X_API_SECRET: ${{ secrets.X_API_SECRET }}
+          X_ACCESS_TOKEN: ${{ secrets.X_ACCESS_TOKEN }}
+          X_ACCESS_TOKEN_SECRET: ${{ secrets.X_ACCESS_TOKEN_SECRET }}
+          BLUESKY_HANDLE: ${{ secrets.BLUESKY_HANDLE }}
+          BLUESKY_APP_PASSWORD: ${{ secrets.BLUESKY_APP_PASSWORD }}
+        run: python3 -m sejmomat.social post
+
+      # also after a failure: posts that did go out must not be repeated
+      - name: Record what was posted
+        if: always()
+        run: |
+          [ -f data/social.json ] || exit 0
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git add --sparse data/social.json
+          if ! git diff --cached --quiet; then
+            git commit -m "Wpisy w mediach społecznościowych $(date -u +%F)"
+            git pull --rebase origin "${GITHUB_REF_NAME}"   # main may have moved since checkout
+            git push
+          fi
